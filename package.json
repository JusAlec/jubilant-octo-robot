    "test": "node --test tests/*.test.js",
    "build:pages": "vite build --mode pages"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "gh-pages": "^6.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
